; One 2D project for Android and Windows; G2 placeholder rooftop.
config_version=5

[application]

config/name="INVARIANT"
config/icon="res://icon.svg"
run/main_scene="res://scenes/rooftop.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

; Preliminary layout for launch checks; not an approved final resolution.
window/size/viewport_width=320
window/size/viewport_height=240
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=0

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
dialogue_choice_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
dialogue_choice_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
dialogue_choice_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
